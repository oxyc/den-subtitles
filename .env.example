# den-subtitles — addon-level configuration. There are NO user credentials here: the OpenSubtitles
# key and the LLM key are BYOK, entered per-install at /configure, and ride in the addon URL (stored
# in the Den Keychain). Every variable is optional; each is shown commented out, with its default.

# HTTP listen port. Default 8093.
# PORT=8093

# Disk cache tier for fetched/translated/synced SRTs, and the sync scratch dir.
# Default $TMPDIR/den-subtitles-cache; the image sets /cache.
# CACHE_DIR=/cache

# Cache byte budget (SRTs are tiny; 256 MiB holds thousands of films). Default 256 MiB.
# CACHE_MAX_BYTES=268435456

# Fixed public origin used to build the /subtitle and /translate URLs handed back to the app.
# Default unset. RECOMMENDED once the addon is reachable by untrusted clients: when unset, the origin
# is derived from the (client-controlled) Host / X-Forwarded-Host header — sanitized to a safe
# charset, but still attacker-influenced. Setting this pins the origin and removes that path entirely.
# PUBLIC_BASE_URL=https://subs.example.com

# Sealed config-in-URL (den-scout/docs/SEALED-CONFIG.md): set this and /configure seals the config to
# it (crypto_box_seal) so the BYOK keys are never plaintext in the URL. A base64 32-byte X25519 private
# key — generate with:  head -c 32 /dev/urandom | base64  — and BACK IT UP (losing it breaks sealed
# installs). Default unset = sealed disabled, legacy plaintext URLs still work. CONFIG_KEYS_PREV holds
# comma-separated prior keys so you can rotate without breaking existing installs — which is why
# rotation is NOT revocation: a leaked link keeps opening. Revoke with the two below instead.
# CONFIG_KEY=
# CONFIG_KEYS_PREV=

# Install revocation. Every /configure link carries an install id (iid) and the epoch it was built
# in (ep). REVOKED_INSTALLS refuses installs by id, comma-separated. Raising CONFIG_EPOCH refuses
# every link stamped below it (links from before ids existed count as 0); new links get the new
# epoch. Default unset / 0 = nothing refused.
# REVOKED_INSTALLS=
# CONFIG_EPOCH=0

# Bearer token for GET /metrics (Prometheus text). Default unset = the route answers 404, like any
# unknown path — the gauges say when a sync or translation is running, i.e. when the install is in use.
# METRICS_TOKEN=

# One stderr line per request: `<METHOD> <path> <status> <ms>ms`, with the config segment shown as
# <config> and the query string left out. Default unset = off; "0" is off too, anything else is on.
# LOG_REQUESTS=1

# Tier-2 audio resync targets: the den-scout origin(s) the app's stream URLs carry, comma-separated.
# A ?resync= URL is honoured only when it is scout's /<config>/play/<token> or /p/<ticket> route at
# one of these.
# Default unset = Tier 2 off (every resync falls back to the unaligned sub). There is no open default:
# an arbitrary URL is a fetch from inside the box, and ffmpeg would follow it anywhere.
# SCOUT_ORIGINS=http://192.168.86.193:8080

# Sync binary paths. Default: looked up on PATH; the image sets /usr/local/bin/alass and
# /usr/local/bin/ffsubsync.
# ALASS_PATH=alass
# FFSUBSYNC_PATH=ffsubsync
